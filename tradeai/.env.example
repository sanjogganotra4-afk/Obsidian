# Copy to tradeai/.env and fill in. NEVER commit the real .env.

# console.anthropic.com -> API Keys (starts with sk-ant-)
ANTHROPIC_API_KEY=

# aistudio.google.com -> Get API Key (starts with AIza),
# or a Vertex AI express-mode key (starts with AQ.)
GEMINI_API_KEY=

# Models (defaults shown; gemini-flash-latest tracks Google's current flash model)
CLAUDE_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-flash-latest

# Council cycle interval during market hours (minutes)
CYCLE_INTERVAL_MINUTES=15

# Set a password whenever the server is reachable from outside your home
# network (cloud deploy, port forward). Blank = no auth (LAN only!).
TRADEAI_PASSWORD=

# Phase 2 only — leave blank until you have Kite Connect credentials
KITE_API_KEY=
KITE_API_SECRET=
