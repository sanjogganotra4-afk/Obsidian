# Copy to tradeai/.env and fill in. NEVER commit the real .env.

# console.anthropic.com -> API Keys (starts with sk-ant-)
ANTHROPIC_API_KEY=

# aistudio.google.com -> Get API Key (starts with AIza)
GEMINI_API_KEY=

# Models (defaults shown)
CLAUDE_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-1.5-flash

# Council cycle interval during market hours (minutes)
CYCLE_INTERVAL_MINUTES=15

# Phase 2 only — leave blank until you have Kite Connect credentials
KITE_API_KEY=
KITE_API_SECRET=
